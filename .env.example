# Optional environment variables. Copy the lines you need into your shell; nothing reads a .env file automatically.
# PowerShell:  $env:DETECTOR_DEVICE = "cpu"

# Checkpoint file name in models/ to use instead of models/active_model.json (e.g. candidate_A_mild.pt).
DETECTOR_MODEL=
# "cpu" forces CPU inference (use when the GPU driver / CUDA fails). Empty = use CUDA when available.
DETECTOR_DEVICE=
# "legacy" switches to the original Keras Xception UI/CLI (needs TensorFlow; rollback only).
DETECTOR_BACKEND=
